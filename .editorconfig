root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml,props,csproj}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{kt,kts}]
ktlint_code_style = ktlint_official
